{
  // Cloudflare Worker config. The Worker name must match the project name in Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mafia-bcn",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The page itself goes through the Worker first, so old addresses can redirect to SITE_URL
    "run_worker_first": ["/", "/index.html"]
  },
  // Main public address. www redirects here; the API keeps working on every host.
  "vars": { "SITE_URL": "https://mafiabcn.com" },
  // The old *.workers.dev address is switched off: the site lives only on mafiabcn.com
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mafia-bcn",
      "database_id": "44855031-78d6-4d0d-bd39-7e3d144a5f23",
      "migrations_dir": "migrations"
    }
  ],
  // Fast key-value storage: the public data copy + weekly backups
  "kv_namespaces": [
    { "binding": "KV", "id": "3d83db4559b14aa7b999bcc53c83bc05" }
  ],
  // Max 30 data requests per minute per IP (protects the free limits)
  "ratelimits": [
    { "name": "RL", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  // Weekly backup: Sundays 07:00 UTC (09:00 Barcelona in summer, 08:00 in winter)
  "triggers": { "crons": ["0 7 * * SUN"] },
  "observability": { "enabled": true }
}
