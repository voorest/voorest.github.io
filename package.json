{
  "name": "mafia-bcn",
  "private": true,
  "version": "0.4.0",
  "description": "Mafia BCN game log: games, stats and titles for our weekend Mafia games",
  "scripts": {
    "dev": "wrangler dev",
    "dev:cron": "wrangler dev --test-scheduled",
    "seed:local": "node scripts/seed-local.mjs",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mafia-bcn --local",
    "db:migrate:remote": "wrangler d1 migrations apply mafia-bcn --remote"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  },
  "type": "module"
}
